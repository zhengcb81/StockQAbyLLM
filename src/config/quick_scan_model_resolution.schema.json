{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockqa.local/schemas/quick_scan_model_resolution.schema.json",
  "title": "Quick Scan Exact Model Resolution Permissions",
  "description": "Independent non-secret versioned configuration; identifiers are exact and never normalized. Empty aliases preserve exact identity only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "aliases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "aliases": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "protocol",
          "requested_model",
          "resolved_model"
        ],
        "properties": {
          "provider": {
            "enum": [
              "openai",
              "minimax",
              "mimo"
            ]
          },
          "protocol": {
            "enum": [
              "responses",
              "anthropic_messages",
              "mimo_chat_completions"
            ]
          },
          "requested_model": {
            "$ref": "#/$defs/exactModel"
          },
          "resolved_model": {
            "$ref": "#/$defs/exactModel"
          }
        },
        "oneOf": [
          {
            "properties": {
              "provider": {
                "const": "openai"
              },
              "protocol": {
                "const": "responses"
              }
            }
          },
          {
            "properties": {
              "provider": {
                "const": "minimax"
              },
              "protocol": {
                "enum": [
                  "responses",
                  "anthropic_messages"
                ]
              }
            }
          },
          {
            "properties": {
              "provider": {
                "const": "mimo"
              },
              "protocol": {
                "const": "mimo_chat_completions"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "exactModel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?!\\s)(?![\\s\\S]*[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890-\\u0891\\u08e2\\u180e\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ud800-\\udfff\\ufeff\\ufff9-\\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f*?\\[\\]])[\\s\\S]*\\S$"
    }
  }
}
