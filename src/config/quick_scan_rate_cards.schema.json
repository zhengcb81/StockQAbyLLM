{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockqa.local/schemas/quick_scan_rate_cards.schema.json",
  "title": "StockQA quick-scan rate-card registry",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "rate_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pricing_ref": {"type": "string", "minLength": 1, "maxLength": 300},
          "provider": {"type": "string", "minLength": 1, "maxLength": 300},
          "model": {"type": "string", "minLength": 1, "maxLength": 300},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "source_ref": {"type": "string", "minLength": 1, "maxLength": 300},
          "source_checked_at": {"type": "string", "format": "date"},
          "rates": {
            "type": "object",
            "properties": {
              "input_per_million_tokens": {"type": "number", "minimum": 0},
              "cached_input_per_million_tokens": {"type": "number", "minimum": 0},
              "cache_creation_input_per_million_tokens": {"type": "number", "minimum": 0},
              "output_per_million_tokens": {"type": "number", "minimum": 0},
              "search_tool_call": {"type": "number", "minimum": 0}
            },
            "required": [
              "input_per_million_tokens",
              "cached_input_per_million_tokens",
              "cache_creation_input_per_million_tokens",
              "output_per_million_tokens",
              "search_tool_call"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "pricing_ref",
          "provider",
          "model",
          "currency",
          "source_ref",
          "source_checked_at",
          "rates"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "rate_cards"],
  "additionalProperties": false
}
